model Contact {
    id        String      @id @default(cuid())
    type      ContactType
    detail    String
    createdAt DateTime    @default(now())
    updatedAt DateTime    @updatedAt
}

model QuoteRequest {
    id                    String      @id @default(cuid())
    customerName          String
    mobileNumber          String
    facebookMessengerName String?
    emailAddress          String?
    consentGiven          Boolean
    selectedService       String
    estimatedPrice        String
    estimateSummary       String
    notes                 String
    adminNotes            String?
    targetCompletionDate  String
    payload               Json
    status                QuoteStatus @default(NEW)
    createdAt             DateTime    @default(now())
    updatedAt             DateTime    @updatedAt
}

/// Editable quote rates for Service Guide calculators.
model PriceRate {
    id         String           @id @default(cuid())
    service    PricingService
    optionKey  String
    variantKey String
    rate       Float
    sortOrder  Int              @default(0)
    createdAt  DateTime         @default(now())
    updatedAt  DateTime         @updatedAt

    @@unique([service, optionKey, variantKey])
    @@index([service])
}

/// Editable fees, minimums, thresholds, and volume-rule copy used by quote calculators.
model PriceSetting {
    id        String   @id @default(cuid())
    key       String   @unique
    group     String
    label     String
    unit      String
    value     Float    @default(0)
    textValue String?
    sortOrder Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([group])
}

// Necessary for auth
model Account {
    id                String  @id @default(cuid())
    userId            String
    type              String
    provider          String
    providerAccountId String
    refresh_token     String? // @db.Text
    access_token      String? // @db.Text
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String? // @db.Text
    session_state     String?
    user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id             String    @id @default(cuid())
    name           String?
    email          String?   @unique
    emailVerified  DateTime?
    image          String?
    hashedPassword String?
    role           UserRole  @default(EDITOR)
    accounts       Account[]
    sessions       Session[]
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

enum UserRole {
    SUPERADMIN
    ADMIN
    EDITOR
}

enum ContactType {
    EMAIL
    FACEBOOK
    INSTAGRAM
    X
    CONTACT_NUMBER
}

enum QuoteStatus {
    NEW
    REVIEWED
    CONTACTED
    CONFIRMED
    IN_PRODUCTION
    COMPLETED
    CLOSED
}

enum PricingService {
    TARPAULIN
    STICKERS
    DTF_SHIRT
    DTF_TRANSFER
    SUBLIMATION
    SIGNAGE_FRAME
    SIGNAGE_SINTRA
}
